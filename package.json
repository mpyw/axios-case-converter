{
  "name": "axios-case-converter",
  "version": "2.0.1",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "lint": "oxlint . && prettier --check \"**/*.{ts,js,mjs,json,md}\"",
    "fix": "oxlint . --fix && prettier --write \"**/*.{ts,js,mjs,json,md}\"",
    "build": "tsup && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:esm": "node test/esm/test-esm-import.mjs",
    "test:all": "npm run test && npm run test:esm",
    "prepack": "npm run build && npm run test:esm",
    "prepublishOnly": "npm run check && npm run lint && npm run test"
  },
  "description": "Axios transformer/interceptor that converts snake_case/camelCase",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mpyw/axios-case-converter.git"
  },
  "keywords": [
    "axios",
    "interceptor",
    "snake",
    "camel",
    "case",
    "convert"
  ],
  "author": "mpyw <ryosuke_i_628@yahoo.co.jp>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mpyw/axios-case-converter/issues"
  },
  "homepage": "https://github.com/mpyw/axios-case-converter#readme",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "camel-case": "^4.1.1",
    "header-case": "^2.0.3",
    "snake-case": "^3.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "axios": "^1.1.2",
    "axios-mock-adapter": "^2.1.0",
    "no-case": "^3.0.4",
    "oxlint": "^1.87.0",
    "prettier": "^3.3.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "axios": ">=1.0.0 <2.0.0"
  }
}
